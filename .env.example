# Supabase project URL (public: exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key (public: exposed to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (SECRET: server-only, bypasses RLS, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# TMDB API read access token (SECRET: server-only)
TMDB_READ_TOKEN=
